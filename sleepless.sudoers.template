# Sleepless passwordless grant — template.
#
# install.sh substitutes __USER__ with your login name ($(id -un)) and installs
# the result to /etc/sudoers.d/sleepless-powerctl, owned root:wheel, mode 0440.
#
# It grants ONE user the right to run the root-owned helper with EXACTLY `on` or
# `off`. The helper accepts no settings from the caller: it snapshots a fixed
# whitelist, applies the fixed awake profile, and restores that snapshot.
__USER__ ALL=(root) NOPASSWD: /Library/PrivilegedHelperTools/com.aboudjem.Sleepless.powerctl on, /Library/PrivilegedHelperTools/com.aboudjem.Sleepless.powerctl off
